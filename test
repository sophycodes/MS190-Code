<!-- INTRO SCENE - Portal Selection -->
<a-entity id="intro-scene">
  
  <!-- LIGHTING -->
  <a-entity light="type: ambient; color: #222; intensity: 0.4"></a-entity>
  <a-entity light="type: point; color: #FF0000; intensity: 2; distance: 20" position="-4 2 -10"></a-entity>
  <a-entity light="type: point; color: #00FF00; intensity: 2; distance: 20" position="0 2 -10"></a-entity>
  <a-entity light="type: point; color: #0000FF; intensity: 2; distance: 20" position="4 2 -10"></a-entity>

  <!-- INTRO WELCOME CARD -->
  <a-entity id="welcome-card" position="0 2 -3">
    
    <!-- Background planes -->
    <a-plane 
      width="10" 
      height="7" 
      position="0 0 0"
      color="#000000"
      opacity="0.9">
    </a-plane>
    
    <a-plane 
      width="10.3" 
      height="7.3" 
      position="0 0 -0.01"
      material="color: #ffffff; shader: flat; opacity: 0.5">
    </a-plane>
    
    <!-- Title -->
    <a-text 
      value="DATA ECHOES & TRACES" 
      align="center" 
      position="0 2.8 0.1" 
      color="#ffffff" 
      width="12"
      shader="flat"
      font="mozillavr">
    </a-text>
    
    <!-- Main text content -->
    <a-text 
      value="Welcome to Cyberspace—where your digital self lives.\n\nYou stand at the threshold of three interconnected realms,\neach filled with data—but not all of it is real.\n\nThe Text Realm (red) — Can you tell truth from fiction?\nThe Audio Realm (green) — Which voices can you trust?\nThe Movement Realm (blue) — Every gesture you make is tracked.\n\nAs you navigate these realms, you won't just observe—you'll\nleave traces. Your choices, your movements, your voice—all\nbecome data. But here's the question: Can you distinguish\nwhat's real from what's fabricated?\n\nIn cyberspace, every action is captured. Every interaction\nleaves a footprint. Some data is truth. Some is illusion.\n\nNavigate the realms. Discern the real from the fake.\nWatch what traces you leave.\n\nWelcome to the echoes."
      align="center" 
      position="0 0.5 0.1" 
      color="#cccccc" 
      width="9"
      line-height="40"
      wrap-count="60"
      shader="flat">
    </a-text>
    
    <!-- START button -->
    <a-entity position="0 -2.8 0" id="start-button-entity">
      <a-box 
        color="#ffffff" 
        depth="0.2" 
        height="0.8" 
        width="3"
        class="clickable"
        material="shader: flat">
      </a-box>
      <a-text 
        value="START" 
        align="center" 
        position="0 0 0.11" 
        color="#000000" 
        width="6"
        shader="flat">
      </a-text>
    </a-entity>
    
  </a-entity>
  <!-- END WELCOME CARD -->

  <!-- LEFT PATHWAY - TEXT (NEON RED) -->
  <a-entity id="pathwayText" class="pathway" position="-3.5 0 0">